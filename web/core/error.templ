package core

import (
	"net/http"
	"strconv"
)

// ErrorPage contains only public status copy and a fixed recovery destination.
// It renders the anonymous masthead because it runs without a signed-in viewer.
templ ErrorPage(status int) {
	@Shell(http.StatusText(status), nil) {
		<main id="main" class="page error-page">
			<div role="alert">
				<h1 class="page-title">{ strconv.Itoa(status) } { http.StatusText(status) }</h1>
				<p class="page-lede">{ errorMessage(status) }</p>
			</div>
			<p><a class="button button--primary" href="/">Back to today's puzzle</a></p>
		</main>
	}
}

func errorMessage(status int) string {
	switch status {
	case http.StatusForbidden:
		return "You do not have access to this page."
	case http.StatusNotFound:
		return "This page is unavailable."
	default:
		return "This page could not be loaded. Try again later."
	}
}
