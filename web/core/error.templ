package core

import (
	"net/http"
	"strconv"
)

// ErrorPage contains only public status copy and a fixed recovery destination,
// in the centred panel the account forms use. viewer is the signed-in player
// for the masthead, or nil.
templ ErrorPage(status int, viewer *Viewer) {
	@Shell(http.StatusText(status), viewer) {
		<main id="main" class="page error-page">
			<div class="form-panel">
				<div class="form-intro" role="alert">
					<svg class="brand-mark" aria-hidden="true"><use href="#mascot"></use></svg>
					<h1 class="page-title">{ errorTitle(status) }</h1>
					<p class="page-lede">{ errorMessage(status) }</p>
				</div>
				<a class="button button--primary button--block" href="/">Back to today's puzzle</a>
			</div>
		</main>
	}
}

func errorTitle(status int) string {
	if status == http.StatusNotFound {
		return "Page not found"
	}
	return strconv.Itoa(status) + " " + http.StatusText(status)
}

func errorMessage(status int) string {
	switch status {
	case http.StatusForbidden:
		return "You do not have access to this page."
	case http.StatusNotFound:
		return "There's nothing at this address. Check the link, or go back to today's puzzle."
	default:
		return "This page could not be loaded. Try again later."
	}
}
