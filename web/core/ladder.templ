package core

// Ladder draws the play board from plain values. start is the start word,
// rungs are the accepted guesses in order and target is the goal (POOP); words
// are case-insensitive and drawn in capitals. A tile is matched (wood) when its
// letter equals the target's in that position. Rungs have stable ids: rung-0
// for the start word, rung-<n> for guess n.
//
// While the last rung is not the target, Ladder draws the input rung (when
// opts.Input), the dashed gap and the dashed goal rung; once it is, the last
// rung is drawn as reached. The input rung shows the letters of the $guess
// signal (up to four lower-case letters, declared here if missing), keeps the
// browser's copy across morphs and clears $guess when the ladder grows. The
// input rung, and the reached rung once the game ends, scroll into view when
// they appear so a long ladder never hides the row being typed.
templ Ladder(start string, rungs []string, target string, opts LadderOptions) {
	<ol class="ladder" aria-label={ "Your ladder from " + upper(start) + " to " + upper(target) } data-signals:guess__ifmissing="''">
		@wordRung(rungID(0), "rung rung--start", start, target, upper(start)+", start word", "")
		for i, word := range rungs {
			if i == len(rungs)-1 && reached(rungs, target) {
				@wordRung(rungID(i+1), rungClass("rung rung--reached", opts.Fresh), word, target, upper(word)+", reached", reachedRungInit)
			} else {
				@wordRung(rungID(i+1), rungClass("rung", opts.Fresh && i == len(rungs)-1), word, target, rungLabel(word, target), "")
			}
		}
		if !reached(rungs, target) {
			if opts.Input {
				@inputRung(len(rungs)+1, opts.Rejection)
			}
			<li class="rung rung--gap" aria-hidden="true"></li>
			<li id="rung-goal" class="rung rung--goal">
				for _, tile := range letterTiles(target, "") {
					<span class="tile" aria-hidden="true">{ tile.Letter }</span>
				}
				<span class="visually-hidden">Goal: { upper(target) }</span>
			</li>
		}
	</ol>
}

// wordRung draws an accepted word; a non-empty init runs when the rung appears.
templ wordRung(id, class, word, target, label, init string) {
	<li
		id={ id }
		class={ class }
		if init != "" {
			data-init={ init }
		}
	>
		for _, tile := range letterTiles(word, target) {
			<span class={ "tile", templ.KV("tile--match", tile.Match) } aria-hidden="true">{ tile.Letter }</span>
		}
		<span class="visually-hidden">{ label }</span>
	</li>
}

// inputRung is never morphed while its id stands, so the browser keeps the
// letters it drew from $guess. A new position clears $guess; a new rejection
// records the refused word and stays tomato until the player edits it. A page
// load starts with an empty $guess, so a stored rejection does not turn the
// empty row tomato or replay its wriggle.
templ inputRung(position, rejection int) {
	if rejection > 0 {
		<li
			id={ inputRungID(position, rejection) }
			class="rung rung--input"
			data-ignore-morph
			data-init={ "$_rejectedGuess = $guess; " + scrollIntoViewExpr }
			data-class:rung--rejected={ rejectedGuessExpr }
		>
			@inputTiles()
			<span class="visually-hidden" data-text={ "'Your next word: ' + ($guess ? $guess.toUpperCase().split('').join(' ') : 'empty') + (" + rejectedGuessExpr + " ? ', rejected' : '')" }>Your next word: empty</span>
		</li>
	} else {
		<li id={ inputRungID(position, 0) } class="rung rung--input" data-ignore-morph data-init={ "$guess = ''; " + scrollIntoViewExpr }>
			@inputTiles()
			<span class="visually-hidden" data-text="'Your next word: ' + ($guess ? $guess.toUpperCase().split('').join(' ') : 'empty')">Your next word: empty</span>
		</li>
	}
}

templ inputTiles() {
	for i := range 4 {
		<span class={ "tile", templ.KV("tile--cursor", i == 0) } aria-hidden="true" data-text={ guessLetterExpr(i) } data-class={ guessTileClassExpr(i) }></span>
	}
}

// MiniWord draws a word as small tiles (finish-sheet solutions), matched
// against target like Ladder, with hidden text naming the word.
templ MiniWord(word, target string) {
	<span class="mini-word">
		for _, tile := range letterTiles(word, target) {
			<span class={ "mini-tile", templ.KV("tile--match", tile.Match) } aria-hidden="true">{ tile.Letter }</span>
		}
	</span>
	<span class="visually-hidden">{ upper(word) }</span>
}

// Keyboard is the on-screen keyboard. Letter keys append to $guess (up to four
// letters), Delete removes the last letter and Enter posts to guessURL once
// four letters are typed; Datastar sends $guess as the "guess" signal. The
// physical keyboard does the same unless focus is on another control. Enter
// shows busy while a guess is in flight. A finished game makes the keyboard
// inert, so neither its keys nor the physical keyboard post guesses.
templ Keyboard(guessURL string, finished bool) {
	<section
		class="keyboard"
		aria-label="Keyboard"
		if finished {
			inert
		}
		data-signals:guess__ifmissing="''"
		data-signals:_guess-busy__ifmissing="false"
		data-on:keydown__window={ keydownExpr(guessURL) }
		data-on:datastar-fetch={ guessBusyExpr }
	>
		<div class="keyboard-row">
			@letterKeys(keyboardRows[0])
		</div>
		<div class="keyboard-row keyboard-row--middle">
			@letterKeys(keyboardRows[1])
		</div>
		<div class="keyboard-row">
			<button type="button" class="key key--wide key--enter" data-attr:aria-busy="$_guessBusy ? 'true' : false" data-on:click={ submitGuessExpr(guessURL) }>Enter</button>
			@letterKeys(keyboardRows[2])
			<button type="button" class="key key--wide" aria-label="Delete letter" data-on:click="$guess = $guess.slice(0, -1)"><svg class="icon" aria-hidden="true"><use href="#i-backspace"></use></svg></button>
		</div>
	</section>
}

templ letterKeys(letters string) {
	for i := range len(letters) {
		<button type="button" class="key" data-on:click={ typeLetterExpr(letters[i : i+1]) }>{ letters[i : i+1] }</button>
	}
}

// Toast is the polite status region for messages such as "Not in word list".
// Render it on every view, with an empty message when there is nothing to say.
// key names the message (unique per game and rejection) so a new message
// animates in. The message the page loaded with stays hidden: the region
// remembers it in $_toastSeen, so a reload does not replay an old rejection.
//
// The region also says "Connection lost. Retrying…" while any request is
// retrying, until the next view arrives from the live stream.
templ Toast(message, key string) {
	<div
		class="toast-region"
		role="status"
		data-signals:_toast-seen__ifmissing={ jsString(toastSeenKey(message, key)) }
		data-signals:_connection-lost__ifmissing="false"
		data-on:datastar-fetch={ connectionExpr }
	>
		if message != "" {
			<p id={ "toast-" + key } class="toast" style="display: none" data-show={ "$_toastSeen !== " + jsString(key) }>{ message }</p>
		}
		<p class="toast toast--steady" style="display: none" data-show="$_connectionLost" data-text="$_connectionLost ? 'Connection lost. Retrying…' : ''"></p>
	</div>
}
