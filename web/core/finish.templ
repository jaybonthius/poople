package core

import "strconv"

// FinishSheet is the finish sheet: a modal dialog with the verdict, route,
// steps against par and the shortest solution, then children for the page's
// own sections. Render it only for a finished game, inside a <main> that
// declares data-signals:_finish-closed__ifmissing="false". It opens as a modal
// (the page behind is inert) and takes focus; Close, Escape or a click on the
// backdrop closes it and moves focus to ShowResultButton, which reopens it.
templ FinishSheet(r FinishResult) {
	<dialog
		id="finish"
		class="sheet"
		tabindex="-1"
		aria-labelledby="finish-title"
		data-preserve-attr="open"
		data-init="$_finishClosed = false"
		data-effect={ finishSheetEffect }
		data-on:close={ finishSheetClosed }
		data-on:click={ finishSheetBackdropClick }
	>
		<div class="sheet-header">
			<div class="result">
				if r.Perfect() {
					<h2 class="verdict verdict--perfect" id="finish-title">Perfect!</h2>
				} else {
					<h2 class="verdict" id="finish-title">Solved</h2>
				}
				<p class="result-route">{ r.Route() }</p>
				<p class="result-score"><span><strong>{ StepCount(r.Steps) }</strong>, par { strconv.Itoa(r.Par) }</span><span class={ "par-delta", templ.KV("par-delta--even", r.Perfect()) }>{ r.parDelta() }</span></p>
			</div>
			<button type="button" class="sheet-close" aria-label="Close" data-on:click="$_finishClosed = true"><svg class="icon" aria-hidden="true"><use href="#i-close"></use></svg></button>
		</div>
		<section class="sheet-section" aria-labelledby="finish-solution-title">
			<h3 class="sheet-section-title" id="finish-solution-title">A shortest ladder</h3>
			<ol class="solution">
				for _, word := range r.Solution {
					<li class="solution-step">
						@MiniWord(word, r.Target)
					</li>
				}
			</ol>
		</section>
		{ children... }
	</dialog>
}

// ShowResultButton reopens a closed finish sheet; it shows only while the
// sheet is closed.
templ ShowResultButton() {
	<button type="button" id="show-result" class="result-link" style="display: none" data-preserve-attr="style" data-show="$_finishClosed" data-on:click="$_finishClosed = false">Show result</button>
}
