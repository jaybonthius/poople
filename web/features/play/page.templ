package play

import (
	"poople/ladder"
	"poople/lib/static"
	"poople/web/core"
	"poople/web/services/game"
	"strconv"
)

// Page is the first load. Its stream element opens the live view and reopens
// it when a first guess gives this browser a player session.
templ Page(viewer *core.Viewer, v playView) {
	@core.Shell("Play", viewer, static.Path("play", "styles/play.css")) {
		<script type="module" src={ static.Path("play", "web-components/share-result.js") }></script>
		<div
			data-init={ streamExpr }
			data-on-signal-patch={ streamExpr }
			data-on-signal-patch-filter="{include: /^_playerSession$/}"
		></div>
		@View(v)
	}
}

const streamExpr = "@get('/play/state', {retry: 'always', retryMaxCount: Infinity})"

// View renders <main> from SQLite state, for both the first load and the stream.
// Par, the solution and the leaderboard are drawn only once the game is finished.
templ View(v playView) {
	<main id="main" class="play" data-signals={ v.signals() } data-signals:_finish-closed__ifmissing="false">
		<div class="puzzle-heading">
			<h1 class="puzzle-title">Daily #{ v.number() }</h1>
			<p class="puzzle-date"><time datetime={ v.opens().Format("2006-01-02") }>{ v.opens().Format("Monday 2 January") }</time></p>
			if v.Game.Finished {
				<button type="button" class="result-link" style="display: none" data-preserve-attr="style" data-show="$_finishClosed" data-on:click="$_finishClosed = false">Show result</button>
			} else if v.Game.Steps == 0 {
				<p class="puzzle-hint">Change one letter at a time. Every step must be a word.</p>
			}
		</div>
		<div class="board">
			@core.Ladder(v.Game.Puzzle.StartWord, v.Game.Ladder[1:], ladder.Target, core.LadderOptions{Input: !v.Game.Finished, Fresh: v.Fresh, Rejection: v.rejectionSeq()})
		</div>
		@core.Keyboard("/play/guess")
		@core.Toast(v.rejectionMessage(), v.rejectionSeq())
		if v.Game.Finished {
			@finishSheet(v)
		}
	</main>
}

templ finishSheet(v playView) {
	<div class="sheet-scrim" data-preserve-attr="style" data-show="!$_finishClosed" data-on:click="$_finishClosed = true"></div>
	<dialog
		id="finish"
		class="sheet"
		open
		tabindex="-1"
		aria-labelledby="finish-title"
		data-preserve-attr="style"
		data-init="$_finishClosed = false; el.focus()"
		data-show="!$_finishClosed"
		data-on:keydown__window="evt.key === 'Escape' && ($_finishClosed = true)"
	>
		<div class="sheet-header">
			<div class="result">
				if v.perfect() {
					<h2 class="verdict verdict--perfect" id="finish-title">Perfect!</h2>
				} else {
					<h2 class="verdict" id="finish-title">Solved</h2>
				}
				<p class="result-route">{ v.route() }</p>
				<p class="result-score"><span><strong>{ steps(v.Game.Steps) }</strong>, par { strconv.Itoa(v.Game.Par) }</span><span class={ "par-delta", templ.KV("par-delta--even", v.perfect()) }>{ v.parDelta() }</span></p>
			</div>
			<button type="button" class="sheet-close" aria-label="Close" data-on:click="$_finishClosed = true"><svg class="icon" aria-hidden="true"><use href="#i-close"></use></svg></button>
		</div>
		<section class="sheet-section" aria-labelledby="finish-solution-title">
			<h3 class="sheet-section-title" id="finish-solution-title">A shortest ladder</h3>
			<ol class="solution">
				for _, word := range v.Game.Solution {
					<li class="solution-step">
						@core.MiniWord(word, ladder.Target)
					</li>
				}
			</ol>
		</section>
		<div class="share-row">
			<share-result id="share-result" data-ignore-morph text={ v.shareText() }></share-result>
			<a class="button" href="/unlimited"><svg class="icon" aria-hidden="true"><use href="#i-unlimited"></use></svg>Play unlimited</a>
		</div>
		@nextPuzzle(v)
		<section class="sheet-section" aria-labelledby="finish-today-title">
			<div class="sheet-section-head">
				<h3 class="sheet-section-title" id="finish-today-title">Today’s leaderboard</h3>
				<span class="live-tag">Live</span>
			</div>
			if len(v.Standings.Rows) > 0 {
				<ol class="standings">
					for i, row := range v.Standings.Rows {
						@standing(row, v.Standings.ViewerAfterGap && i == len(v.Standings.Rows)-1)
					}
				</ol>
			}
			if v.Standings.Unlisted() > 0 {
				<p class="footnote">{ v.unlistedFootnote() }</p>
			}
			if !v.SignedIn {
				<p class="footnote"><a class="text-link" href="/signup">Create an account</a> to appear on the leaderboard by name.</p>
			}
		</section>
		<p class="sheet-links"><a class="text-link" href="/stats">Your statistics</a><a class="text-link" href="/leaderboard">Full leaderboard</a></p>
	</dialog>
}

// nextPuzzle counts down to the next 08:00 UTC in the browser from the time
// the server rendered; the stream switches to the new puzzle when it opens.
templ nextPuzzle(v playView) {
	{{ text, iso := countdown(v.NextIn) }}
	<p class="countdown" data-init={ countdownInit(v.NextIn) } data-on-interval="$_now = Date.now()">
		Next puzzle in <time datetime={ iso } data-attr:datetime={ countdownISO } data-text={ countdownText }>{ text }</time>
	</p>
}

// standing is one row of today's leaderboard; apart marks the viewer's row
// when other finishers rank between it and the rows above.
templ standing(row game.Standing, apart bool) {
	<li class={ "standing", templ.KV("standing--you", row.You), templ.KV("standing--apart", apart) }>
		<span class={ "rank", templ.KV("rank--first", row.Rank == 1) }>{ strconv.Itoa(row.Rank) }</span>
		@core.Avatar(avatarURL(row))
		<span class="standing-name">
			if row.Username != "" {
				{ row.Username }
			} else {
				Anonymous
			}
			if row.You {
				<span class="you-tag">You</span>
			}
		</span>
		<span class="standing-steps">{ strconv.Itoa(row.Steps) } <span class="visually-hidden">steps</span></span>
		<span class="standing-time"><span class="visually-hidden">in </span>{ clock(row.SolveTime) }</span>
	</li>
}
